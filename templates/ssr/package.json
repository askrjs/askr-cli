{
  "name": "{{appName}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr server.ts --outDir dist/server",
    "preview": "node dist/server/server.js",
    "test": "vp test run -c ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint src server.ts tests vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "analyze": "askr analyze --check",
    "fmt": "vp fmt \"src/**/*.{ts,tsx,css}\" \"server.ts\" \"tests/**/*.{ts,tsx}\" \"*.md\"",
    "check": "askr check"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.5.0 <0.6.0",
    "@askrjs/node": ">=0.5.0 <0.6.0",
    "@askrjs/server": ">=0.5.0 <0.6.0",
    "@askrjs/themes": ">=0.5.0 <0.6.0",
    "@askrjs/ui": ">=0.5.0 <0.6.0"
  },
  "devDependencies": {
    "@askrjs/vite": ">=0.5.0 <0.6.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
