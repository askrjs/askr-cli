{
  "name": "{{appName}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr server.ts --outDir dist/server",
    "preview": "node dist/server/server.js",
    "test": "vp test run",
    "type-check": "tsc --noEmit",
    "lint": "vp lint src server.ts tests vite.config.ts",
    "lint:fix": "vp lint --fix src server.ts tests vite.config.ts",
    "fmt": "vp fmt \"src/**/*.{ts,tsx,css}\" \"server.ts\" \"tests/**/*.{ts,tsx}\" \"*.md\""
  },
  "dependencies": {
    "@askrjs/askr": ">=0.0.34 <0.1.0",
    "@askrjs/node": ">=0.0.1 <0.1.0",
    "@askrjs/server": ">=0.0.1 <0.1.0",
    "@askrjs/themes": ">=0.0.3 <0.1.0",
    "@askrjs/ui": ">=0.0.5 <0.1.0"
  },
  "devDependencies": {
    "@askrjs/vite": ">=0.0.2 <0.1.0",
    "@types/node": "^25.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.19"
  }
}
