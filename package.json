{
  "name": "@askrjs/cli",
  "version": "0.0.1",
  "description": "Unified CLI for the askr platform",
  "homepage": "https://github.com/askrjs/askr-cli#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-cli/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/askrjs/askr-cli.git"
  },
  "bin": {
    "askr": "./dist/cli.js",
    "askr-add": "./dist/add.js",
    "askr-create": "./dist/create.js",
    "askr-ssg": "./dist/ssg.js",
    "asrk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "npx rimraf dist node_modules",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run -c vitest.config.ts",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@askrjs/askr": "^0.0.39"
  },
  "devDependencies": {
    "@askrjs/charts": "^0.0.1",
    "@askrjs/logos": "^0.0.1",
    "@askrjs/lucide": "^0.0.2",
    "@askrjs/themes": "^0.0.4",
    "@askrjs/ui": "^0.0.7",
    "@askrjs/vite": "^0.0.2",
    "@types/node": "^25.9.1",
    "vite-plus": "^0.1.22"
  },
  "engines": {
    "node": ">=18"
  }
}
