{
  "name": "@askrjs/cli",
  "version": "0.0.2",
  "description": "Unified CLI for the askr platform",
  "homepage": "https://github.com/askrjs/askr-cli#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-cli/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-cli.git"
  },
  "bin": {
    "askr": "./dist/cli.js",
    "askr-add": "./dist/add.js",
    "askr-create": "./dist/create.js",
    "askr-openapi": "./dist/openapi.js",
    "askr-ssg": "./dist/ssg.js",
    "asrk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "npx rimraf dist node_modules",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run -c vitest.config.ts",
    "fmt": "vp fmt .",
    "lint": "vp lint src tests vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.0.30 <0.1.0",
    "@askrjs/charts": ">=0.0.1 <0.1.0",
    "@askrjs/logos": ">=0.0.1 <0.1.0",
    "@askrjs/lucide": ">=0.0.1 <0.1.0",
    "@askrjs/themes": ">=0.0.1 <0.1.0",
    "@askrjs/ui": ">=0.0.1 <0.1.0",
    "@askrjs/vite": ">=0.0.1 <0.1.0",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.24",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tsx": "^4.23.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.0.30 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@askrjs/askr": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
