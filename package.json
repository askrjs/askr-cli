{
  "name": "@askrjs/cli",
  "version": "0.0.2",
  "description": "Unified CLI for the Askr platform",
  "homepage": "https://github.com/askrjs/askr-cli#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-cli/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-cli.git"
  },
  "bin": {
    "askr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "npx rimraf dist node_modules",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run -c vitest.config.ts",
    "fmt": "vp fmt .",
    "lint": "vp lint src tests vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:publint": "publint",
    "pack:check": "npm pack --ignore-scripts --dry-run --json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:publint && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.5",
    "semver": "^7.8.5",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.0.53 <0.1.0",
    "@askrjs/charts": ">=0.0.4 <0.1.0",
    "@askrjs/logos": ">=0.0.3 <0.1.0",
    "@askrjs/lucide": ">=0.0.3 <0.1.0",
    "@askrjs/themes": ">=0.0.12 <0.1.0",
    "@askrjs/ui": ">=0.0.13 <0.1.0",
    "@askrjs/vite": ">=0.0.6 <0.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/semver": "^7.7.1",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.0.53 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@askrjs/askr": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
